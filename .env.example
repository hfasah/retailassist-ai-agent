# Copy to .env and fill in. Never commit .env.

# Which model provider to use: gemini (default) or claude
RETAILASSIST_LLM_PROVIDER=gemini

# Gemini: either a Gemini API key...
GEMINI_API_KEY=
# ...or Vertex AI (on Cloud Run, the service account provides credentials)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.8-flash

# Claude (only needed when RETAILASSIST_LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Secret for staff-only ticket endpoints (sent as the X-API-Key header).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RETAILASSIST_STAFF_API_KEY=

# Bearer token clients must send to the MCP server over HTTP (retailassist-mcp --transport http)
RETAILASSIST_MCP_TOKEN=

# Optional: where to store support tickets and saved conversations
# RETAILASSIST_TICKETS_DB=data/tickets.db
# RETAILASSIST_CONVERSATIONS_DB=data/conversations.db
# RETAILASSIST_VECTOR_DB=data/vectordb
