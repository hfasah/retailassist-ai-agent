# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Secret for staff-only ticket endpoints (sent as the X-API-Key header).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RETAILASSIST_STAFF_API_KEY=

# Optional: where to store support tickets (default: data/tickets.db)
